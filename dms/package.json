{
  "name": "dms-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"Client,Server\" -c \"cyan,blue\" \"npm run dev --workspace=client\" \"npm run start:dev --workspace=server\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "install:all": "npm install",
    "predev": "kill-port 3000 4000 || exit 0",
    "prestart": "kill-port 3000 4000 || exit 0",
    "start": "concurrently -p \"[{name}]\" -n \"Client,Server\" -c \"magenta,green\" \"npm run start --workspace=client\" \"npm run start:prod --workspace=server\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "kill-port": "^2.0.1"
  }
}