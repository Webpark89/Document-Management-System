digraph DMS { graph [rankdir=TB, splines=ortho, nodesep=0.38, ranksep=0.72, bgcolor="white", pad=0.25, outputorder=edgesfirst]; node [shape=plain, fontname="Arial"]; edge [color="#7d858d", penwidth=1.15, arrowsize=0.75, fontname="Arial", fontsize=11, labelfontcolor="#343b42", labeldistance=1.5];
